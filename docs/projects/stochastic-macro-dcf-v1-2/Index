  <!-- ===================== INPUT FORM ===================== -->
  <section class="inputs-section">
    <div class="container">
 
      <!-- Contextual help box — updates on field focus -->
      <div class="help-box" id="help-box">
        <span class="help-icon">?</span>
        <div class="help-content">
          <span class="help-title" id="help-title">Input Guide</span>
          <span class="help-body" id="help-body">Click any field to see a brief explanation and example value.</span>
        </div>
      </div>
 
      <form id="model-form" autocomplete="off">
 
        <!-- ========== SIMPLE INPUTS ========== -->
 
        <div class="input-section-label">Macro Environment</div>
        <div class="simple-grid">
 
          <div class="field"
            data-help-title="Current Oil Price"
            data-help-body="Starting oil price for all simulated paths. Example: 70–85.">
            <label for="commodity_current">Current Oil Price <span class="unit">$/bbl</span></label>
            <input type="number" id="commodity_current" value="75" step="1" />
          </div>
 
          <div class="field"
            data-help-title="Oil Volatility"
            data-help-body="How widely oil prices vary across scenarios. Example: 0.15–0.30.">
            <label for="commodity_vol">Oil Volatility <span class="unit">annual σ</span></label>
            <input type="number" id="commodity_vol" value="0.20" step="0.01" />
          </div>
 
          <div class="field"
            data-help-title="Long-Run Oil Target"
            data-help-body="The price level oil tends to revert toward over time. Example: 65–85.">
            <label for="commodity_long_run_mean">Long-Run Oil Target <span class="unit">$/bbl</span></label>
            <input type="number" id="commodity_long_run_mean" value="70" step="1" />
          </div>
 
          <div class="field"
            data-help-title="Interest Rate"
            data-help-body="Starting risk-free rate used in discounting. Entered as a decimal. Example: 0.04 = 4%.">
            <label for="rate_current">Interest Rate <span class="unit">rf</span></label>
            <input type="number" id="rate_current" value="0.045" step="0.001" />
          </div>
 
          <div class="field"
            data-help-title="Demand Growth"
            data-help-body="Baseline annual growth rate for the demand series. Example: 0.01–0.03.">
            <label for="demand_growth">Demand Growth <span class="unit">annual</span></label>
            <input type="number" id="demand_growth" value="0.02" step="0.005" />
          </div>
 
        </div>
 
        <div class="input-section-label" style="margin-top:2.25rem;">Company</div>
        <div class="simple-grid">
 
          <div class="field"
            data-help-title="Revenue"
            data-help-body="Current annual revenue used as the operating base. Example: 15,000–30,000.">
            <label for="current_revenue">Revenue <span class="unit">$M</span></label>
            <input type="number" id="current_revenue" value="20000" step="500" />
          </div>
 
          <div class="field"
            data-help-title="Production"
            data-help-body="Current production level used to anchor operating scale.">
            <label for="current_production">Production <span class="unit">Mboe/d</span></label>
            <input type="number" id="current_production" value="500" step="10" />
          </div>
 
          <div class="field"
            data-help-title="EBIT Margin"
            data-help-body="Base operating profitability at current oil price conditions. Example: 0.20–0.40.">
            <label for="base_operating_margin">EBIT Margin</label>
            <input type="number" id="base_operating_margin" value="0.30" step="0.01" />
          </div>
 
          <div class="field"
            data-help-title="Capex % Rev"
            data-help-body="Share of revenue reinvested into the business. Example: 0.12–0.22.">
            <label for="capex_percent_revenue">Capex % Rev</label>
            <input type="number" id="capex_percent_revenue" value="0.18" step="0.01" />
          </div>
 
          <div class="field"
            data-help-title="D&A % Rev"
            data-help-body="Non-cash depreciation and amortization as a share of revenue; added back to FCF.">
            <label for="da_percent_revenue">D&amp;A % Rev</label>
            <input type="number" id="da_percent_revenue" value="0.06" step="0.01" />
          </div>
 
          <div class="field"
            data-help-title="WC % Rev"
            data-help-body="Working capital intensity relative to revenue. Example: 0.03–0.08.">
            <label for="working_capital_percent_revenue">WC % Rev</label>
            <input type="number" id="working_capital_percent_revenue" value="0.05" step="0.01" />
          </div>
 
          <div class="field"
            data-help-title="Shares"
            data-help-body="Shares outstanding used to convert equity value to per-share price.">
            <label for="shares_outstanding">Shares <span class="unit">M</span></label>
            <input type="number" id="shares_outstanding" value="1500" step="10" />
          </div>
 
          <div class="field"
            data-help-title="Net Debt"
            data-help-body="Debt minus cash, subtracted from enterprise value to arrive at equity value.">
            <label for="net_debt">Net Debt <span class="unit">$M</span></label>
            <input type="number" id="net_debt" value="5000" step="100" />
          </div>
 
          <div class="field"
            data-help-title="Market Price"
            data-help-body="Current stock price used as the reference for probability-below-market.">
            <label for="current_stock_price">Market Price <span class="unit">$/share</span></label>
            <input type="number" id="current_stock_price" value="42" step="0.5" />
          </div>
 
        </div>
 
        <div class="input-section-label" style="margin-top:2.25rem;">Simulation</div>
        <div class="simple-grid simple-grid--narrow">
          <div class="field"
            data-help-title="Simulations"
            data-help-body="Number of Monte Carlo paths. More paths produce a smoother distribution. Example: 500–2,000.">
            <label for="num_simulations">Simulations</label>
            <input type="number" id="num_simulations" value="1000" step="100" min="100" max="5000" />
          </div>
        </div>
 
        <!-- ========== ADVANCED SETTINGS (collapsed) ========== -->
        <details class="advanced-details" id="advanced-section">
          <summary class="advanced-summary">
            <span class="adv-chevron">▸</span>
            Advanced Settings
            <span class="adv-note">Reversion speeds · sensitivities · WACC components · random seed</span>
          </summary>
 
          <div class="advanced-body">
 
            <div class="adv-group-label">Oil Price Process</div>
            <div class="simple-grid simple-grid--narrow">
              <div class="field"
                data-help-title="Commodity Reversion Speed"
                data-help-body="How quickly oil prices are pulled back toward the long-run target. Example: 0.01–0.10.">
                <label for="commodity_reversion_speed">Reversion Speed κ</label>
                <input type="number" id="commodity_reversion_speed" value="0.02" step="0.01" />
              </div>
            </div>
 
            <div class="adv-group-label">Interest Rate Process</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Rate Reversion Speed"
                data-help-body="How quickly rates return toward their long-run level. Example: 0.10–0.50.">
                <label for="rate_drift">Reversion Speed κ</label>
                <input type="number" id="rate_drift" value="0.30" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Rate Volatility"
                data-help-body="How much interest rates fluctuate path to path. Example: 0.005–0.015.">
                <label for="rate_vol">Rate Volatility σ</label>
                <input type="number" id="rate_vol" value="0.008" step="0.001" />
              </div>
              <div class="field"
                data-help-title="Rate Long-Run Target"
                data-help-body="Long-run anchor for interest rates. Example: 0.03–0.05.">
                <label for="rate_long_run_mean">Long-Run Target</label>
                <input type="number" id="rate_long_run_mean" value="0.040" step="0.005" />
              </div>
            </div>
 
            <div class="adv-group-label">Demand Process</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Demand Index Level"
                data-help-body="Starting level of the demand series. Only deviations from this level affect the model.">
                <label for="demand_current">Demand Index Level</label>
                <input type="number" id="demand_current" value="100" step="1" />
              </div>
              <div class="field"
                data-help-title="Demand Volatility"
                data-help-body="How much demand fluctuates path to path. Example: 0.03–0.10.">
                <label for="demand_vol">Demand Volatility σ</label>
                <input type="number" id="demand_vol" value="0.06" step="0.01" />
              </div>
            </div>

            <div class="adv-group-label">Correlation Structure</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Corr(Oil, Rates)"
                data-help-body="Correlation between oil price shocks and interest rate shocks. Typically negative (flight to safety lowers rates when oil/demand falls). Example: -0.30 to 0.0.">
                <label for="corr_oil_rate">Corr(Oil, Rates)</label>
                <input type="number" id="corr_oil_rate" value="-0.20" step="0.05" min="-0.95" max="0.95" />
              </div>
              <div class="field"
                data-help-title="Corr(Oil, Demand)"
                data-help-body="Correlation between oil price shocks and demand shocks. Typically positive (strong demand pushes oil prices up together). Example: 0.20–0.50.">
                <label for="corr_oil_demand">Corr(Oil, Demand)</label>
                <input type="number" id="corr_oil_demand" value="0.30" step="0.05" min="-0.95" max="0.95" />
              </div>
              <div class="field"
                data-help-title="Corr(Rates, Demand)"
                data-help-body="Correlation between interest rate shocks and demand shocks. Typically positive (strong growth raises both rates and demand). Example: 0.10–0.30.">
                <label for="corr_rate_demand">Corr(Rates, Demand)</label>
                <input type="number" id="corr_rate_demand" value="0.20" step="0.05" min="-0.95" max="0.95" />
              </div>
            </div>

            <div class="adv-group-label">Distress Dynamics</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Distress Price Threshold"
                data-help-body="Trailing oil price level below which financial distress dynamics kick in (capex pullback, wider debt spreads). Usually above the cash breakeven price. Example: 40–55.">
                <label for="distress_price_threshold">Distress Price Threshold</label>
                <input type="number" id="distress_price_threshold" value="45" step="1" />
              </div>
              <div class="field"
                data-help-title="Distress Trailing Window"
                data-help-body="Number of trailing years averaged to determine whether a path is in financial distress. Example: 1–3.">
                <label for="distress_trailing_years">Distress Trailing Window (yrs)</label>
                <input type="number" id="distress_trailing_years" value="2" step="1" min="1" />
              </div>
              <div class="field"
                data-help-title="Capex Pullback Sensitivity"
                data-help-body="Maximum additional cut to Capex % Rev when a path is fully in distress (trailing price at or below zero relative to threshold). Example: 0.05–0.15.">
                <label for="capex_pullback_sensitivity">Capex Pullback Sensitivity</label>
                <input type="number" id="capex_pullback_sensitivity" value="0.10" step="0.01" />
              </div>
              <div class="field"
                data-help-title="Debt Spread Distress Sensitivity"
                data-help-body="Maximum additional debt spread (in absolute terms) added when a path is fully in distress, representing refinancing/rollover risk. Example: 0.01–0.04.">
                <label for="debt_spread_distress_sensitivity">Debt Spread Distress Sensitivity</label>
                <input type="number" id="debt_spread_distress_sensitivity" value="0.02" step="0.005" />
              </div>
            </div>
 
            <div class="adv-group-label">Sensitivity Parameters</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Revenue ← Commodity"
                data-help-body="How strongly revenue responds to oil price changes. Example: 0.50–0.90.">
                <label for="revenue_sensitivity_to_commodity">Revenue ← Commodity</label>
                <input type="number" id="revenue_sensitivity_to_commodity" value="0.70" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Revenue ← Demand"
                data-help-body="How strongly revenue responds to demand changes. Example: 0.20–0.50.">
                <label for="revenue_sensitivity_to_demand">Revenue ← Demand</label>
                <input type="number" id="revenue_sensitivity_to_demand" value="0.30" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Margin ← Commodity"
                data-help-body="Absolute change in EBIT margin per 1% change in oil price, applied above the cash breakeven price. Example: 0.10–0.30.">
                <label for="margin_sensitivity_to_commodity">Margin ← Commodity</label>
                <input type="number" id="margin_sensitivity_to_commodity" value="0.20" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Cash Breakeven Price"
                data-help-body="Per-unit cash cost level. Below this price, fixed costs no longer scale down and margin compression accelerates. Example: 35–50.">
                <label for="cash_breakeven_price">Cash Breakeven Price</label>
                <input type="number" id="cash_breakeven_price" value="40" step="1" />
              </div>
              <div class="field"
                data-help-title="Below-Breakeven Multiplier"
                data-help-body="How much steeper margin sensitivity becomes once price falls below cash breakeven. 1.0 = no change in slope; 2.0 = twice as steep. Example: 1.5–3.0.">
                <label for="below_breakeven_multiplier">Below-Breakeven Multiplier</label>
                <input type="number" id="below_breakeven_multiplier" value="2.0" step="0.1" />
              </div>
              <div class="field"
                data-help-title="Structural Margin Floor"
                data-help-body="Minimum EBIT margin the model allows, representing the point where a producer would shut in production rather than operate at a larger loss. Example: -0.30 to -0.10.">
                <label for="structural_margin_floor">Structural Margin Floor</label>
                <input type="number" id="structural_margin_floor" value="-0.20" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Capex ← Commodity"
                data-help-body="How much capex intensity responds to oil price changes. Example: 0.05–0.15.">
                <label for="capex_sensitivity_to_commodity">Capex ← Commodity</label>
                <input type="number" id="capex_sensitivity_to_commodity" value="0.10" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Production ← Reinvestment"
                data-help-body="How strongly above-baseline reinvestment supports future production. Example: 0.02–0.08.">
                <label for="production_growth_sensitivity_to_reinvestment">Production ← Reinvestment</label>
                <input type="number" id="production_growth_sensitivity_to_reinvestment" value="0.05" step="0.01" />
              </div>
            </div>
 
            <div class="adv-group-label">WACC &amp; Valuation</div>
            <div class="simple-grid">
              <div class="field"
                data-help-title="Tax Rate"
                data-help-body="Effective tax rate applied to EBIT and cost of debt. Example: 0.20–0.30.">
                <label for="tax_rate">Tax Rate</label>
                <input type="number" id="tax_rate" value="0.25" step="0.01" />
              </div>
              <div class="field"
                data-help-title="Beta"
                data-help-body="Equity sensitivity used in the cost of equity. Example: 1.0–1.5.">
                <label for="beta">Beta</label>
                <input type="number" id="beta" value="1.20" step="0.05" />
              </div>
              <div class="field"
                data-help-title="ERP"
                data-help-body="Equity risk premium used in WACC. Example: 0.04–0.06.">
                <label for="equity_risk_premium">ERP</label>
                <input type="number" id="equity_risk_premium" value="0.055" step="0.005" />
              </div>
              <div class="field"
                data-help-title="Debt Spread"
                data-help-body="Spread above the risk-free rate used in cost of debt. Example: 0.01–0.03.">
                <label for="debt_spread">Debt Spread</label>
                <input type="number" id="debt_spread" value="0.015" step="0.005" />
              </div>
              <div class="field"
                data-help-title="Debt Weight"
                data-help-body="Debt share of capital used in WACC. Example: 0.20–0.40.">
                <label for="debt_weight">Debt Weight</label>
                <input type="number" id="debt_weight" value="0.30" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Equity Weight"
                data-help-body="Equity share of capital used in WACC. Should sum to 1 with debt weight.">
                <label for="equity_weight">Equity Weight</label>
                <input type="number" id="equity_weight" value="0.70" step="0.05" />
              </div>
              <div class="field"
                data-help-title="Terminal Growth"
                data-help-body="Perpetual growth assumption in terminal value. Must be below WACC. Example: 0.015–0.03.">
                <label for="terminal_growth">Terminal Growth</label>
                <input type="number" id="terminal_growth" value="0.025" step="0.005" />
              </div>
              <div class="field"
                data-help-title="Terminal FCF Smoothing Years"
                data-help-body="Number of final forecast years averaged to form the terminal-year FCF base, so one noisy year doesn't dominate the terminal value. 1 = use the raw final year only (old behavior). Example: 2–4.">
                <label for="terminal_smoothing_years">Terminal FCF Smoothing Years</label>
                <input type="number" id="terminal_smoothing_years" value="3" step="1" min="1" />
              </div>
              <div class="field"
                data-help-title="Forecast Years"
                data-help-body="Number of explicit forecast years before terminal value.">
                <label for="forecast_years">Forecast Years</label>
                <input type="number" id="forecast_years" value="5" step="1" min="1" max="10" />
              </div>
            </div>
 
            <div class="adv-group-label">Simulation Control</div>
            <div class="simple-grid simple-grid--narrow">
              <div class="field"
                data-help-title="Random Seed"
                data-help-body="Optional fixed seed for reproducible runs. Leave blank for a fresh result each run.">
                <label for="random_seed">Random Seed <span class="unit">blank = random each run</span></label>
                <input type="number" id="random_seed" value="" step="1" placeholder="leave blank for random" />
              </div>
            </div>
 
          </div><!-- /advanced-body -->
        </details>
 
        <!-- RUN BUTTON -->
        <div class="run-row">
          <button type="button" id="run-btn" onclick="runModel()">Run Simulation</button>
          <span id="run-status" class="run-status"></span>
        </div>
 
      </form>
    </div>
  </section>
 
  <!-- ===================== RESULTS ===================== -->
  <section class="results-section" id="results-section" style="display:none;">
    <div class="container">
 
      <div class="results-header">
        <h2 class="section-title">Valuation Output</h2>
        <span class="results-meta" id="results-meta"></span>
      </div>
 
      <!-- Summary Cards -->
      <div class="summary-grid" id="summary-grid"></div>
 
      <!-- Distribution Histogram -->
      <div class="chart-block">
        <div class="chart-block-header">
          <div class="chart-title">Value Distribution</div>
          <div class="chart-sub">Implied per-share equity value across all simulated paths · hover bars for details · red line = current market price</div>
        </div>
        <div class="chart-wrap chart-wrap--hist">
          <canvas id="hist-canvas"></canvas>
        </div>
      </div>
 
      <!-- Commodity Price Paths -->
      <div class="chart-block">
        <div class="chart-block-header">
          <div class="chart-title">Commodity Price Paths</div>
          <div class="chart-sub">15 representative oil price paths · central path highlighted</div>
        </div>
        <div class="chart-wrap">
          <canvas id="commodity-canvas"></canvas>
        </div>
      </div>
 
      <!-- FCF Paths -->
      <div class="chart-block">
        <div class="chart-block-header">
          <div class="chart-title">Free Cash Flow Paths</div>
          <div class="chart-sub">FCF ($M) across 15 representative paths</div>
        </div>
        <div class="chart-wrap">
          <canvas id="fcf-canvas"></canvas>
        </div>
      </div>
 
      <!-- WACC Paths -->
      <div class="chart-block">
        <div class="chart-block-header">
          <div class="chart-title">WACC Paths</div>
          <div class="chart-sub">Discount rate variation driven by simulated interest rate paths</div>
        </div>
        <div class="chart-wrap chart-wrap--short">
          <canvas id="wacc-canvas"></canvas>
        </div>
      </div>
 
    </div>
  </section>
 
  <!-- ===================== FOOTER ===================== -->
  <footer class="site-footer">
    <div class="container">
      <p>Stochastic Macro-Driven DCF · OPResearch · v1</p>
      <p class="footer-note">State variables simulated independently — no cross-correlation. Correlated paths planned for v2.</p>
    </div>
  </footer>
 
  <script src="script.js?v=2"></script>
</body>
</html>
